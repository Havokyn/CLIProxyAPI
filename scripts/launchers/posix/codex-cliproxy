#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/cliproxy-env.sh"
cliproxy_settings || { code=$?; [ "$code" -eq 10 ] && exit 0; exit "$code"; }
export CLIPROXY_API_KEY=$CLIPROXY_KEY
export CODEX_HOME=${CODEX_HOME:-$HOME/.codex-cliproxy}
exec "${CODEX_BIN:-codex}" --profile "${CLIPROXY_CODEX_PROFILE:-cliproxy}" --model "$CLIPROXY_MODEL" -c "model_providers.cliproxy.base_url=\"$CLIPROXY_BASE_URL/v1\"" "$@"
